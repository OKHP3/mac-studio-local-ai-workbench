#!/usr/bin/env bash
# Blocks commits that would publish machine or network identifiers.
# Enable once per clone:  git config core.hooksPath .githooks
set -u
fail=0
added=$(git diff --cached -U0 --no-color -- . ':!.gitleaks.toml' ':!.githooks' | grep -E '^\+[^+]' || true)

# 1. Local literal denylist (untracked; one fixed string per line)
deny="$(git rev-parse --git-dir)/info/okh-denylist"
if [ -s "$deny" ] && [ -n "$added" ]; then
  hits=$(printf '%s\n' "$added" | grep -F -f "$deny" || true)
  if [ -n "$hits" ]; then echo "pre-commit: denylisted value staged:"; printf '%s\n' "$hits" | cut -c1-160; fail=1; fi
fi

# 2. gitleaks with repo rules, or a regex fallback when gitleaks is absent
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --pre-commit --staged --redact --no-banner -c .gitleaks.toml || fail=1
elif [ -n "$added" ]; then
  re='tail[0-9a-f]{4,}\.ts\.net|Serial Number[^:]*:\s*[A-Z0-9]{10,12}|Hardware UUID:|Provisioning UDID:|\b(10\.[0-9]{1,3}|192\.168)\.[0-9]{1,3}\.[0-9]{1,3}\b|/Users/[A-Za-z0-9._-]+/'
  hits=$(printf '%s\n' "$added" | grep -E "$re" || true)
  if [ -n "$hits" ]; then echo "pre-commit: identifier pattern staged (install gitleaks for full scan):"; printf '%s\n' "$hits" | cut -c1-160; fail=1; fi
fi

[ $fail -eq 0 ] || { echo "Commit blocked. Use placeholders: <MAC_LAN_IP>, <HOME_SSID>, <host>.<tailnet>.ts.net, ~"; exit 1; }
