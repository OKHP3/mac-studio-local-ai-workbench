# Mac Studio Local AI Workbench — Environment Variables
# Copy relevant variables to ~/.zprofile on the Mac Studio.
# DO NOT store actual tokens in this file.

# ─── Ollama ───────────────────────────────────────────────────────────────────
# Canonical model storage path on external NVMe
OLLAMA_MODELS="/Volumes/OKH-Local/07_Local_LLMs/ollama/models"

# Performance flags for Apple Silicon
OLLAMA_FLASH_ATTENTION="1"
OLLAMA_KV_CACHE_TYPE="q8_0"

# ─── Hugging Face ─────────────────────────────────────────────────────────────
# External cache — keeps model downloads off internal SSD
HF_HOME="/Volumes/OKH-Local/07_Local_LLMs/huggingface-cache"
HUGGINGFACE_HUB_CACHE="/Volumes/OKH-Local/07_Local_LLMs/huggingface-cache/hub"

# ─── Navigation alias ─────────────────────────────────────────────────────────
# Add to ~/.zprofile to navigate to OKH working directory with: okhp3
# alias okhp3="cd ~/OneDrive/Documents/OverKill\ Hill\ P³\ \(Protocol-Driven\ Power\ Prompts\)"

# ─── NOT stored here ──────────────────────────────────────────────────────────
# GitHub PAT: store only in private local configuration.
# Notion integration token: store only in private local configuration.
# Hugging Face auth token: store only in the local Hugging Face cache/keychain.
# MCP tokens: store only in private local configuration. Never commit them.
